---
import SiteLayout from "~/layouts/SiteLayout.astro";
import { SITE_NAME } from "~/lib/constants";
---

<SiteLayout title="Page not found" robots="noindex, follow">
  <section class="py-2 sm:py-4">
    <div class="max-w-2xl mx-auto p-4 sm:p-6 space-y-8">
      <div class="blur-entrance-content space-y-3">
        <a class="text-muted-foreground" href="/">{SITE_NAME}</a>
        <h2>Page not found.</h2>
        <p class="text-muted-foreground">
          The page you requested does not exist. <a
            class="hover:text-primary underline underline-offset-2"
            href="/">Back home</a
          >.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
