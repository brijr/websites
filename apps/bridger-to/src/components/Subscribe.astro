---
import Icon from "~/components/Icon.astro";
---

<div class="bg-muted/30 p-3 border rounded">
  <form class="space-y-3" data-subscribe>
    <div class="space-y-2">
      <label
        class="text-sm font-medium leading-none text-muted-foreground"
        for="email"
      >
        Subscribe to my newsletter
      </label>
      <input
        type="email"
        inputmode="email"
        autocomplete="email"
        name="email"
        id="email"
        required
        placeholder="your@email.com"
        class="w-full bg-transparent border-b border-input pt-3 pb-1 focus:outline-none focus-visible:border-foreground transition-[border-color] duration-200 placeholder:text-muted-foreground/50"
      />
      <p class="text-sm text-muted-foreground sr-only">
        Enter your email address to subscribe.
      </p>
    </div>
    <button
      type="submit"
      class="group flex items-center gap-1.5 text-muted-foreground hover:text-primary transition-[color,scale] duration-200 ease-out active:scale-[0.97] hover:cursor-pointer"
    >
      <Icon
        name="arrow-right"
        size={16}
        class="group-hover:translate-x-0.5 transition-transform duration-400"
      />
      <span data-subscribe-label>Subscribe</span>
    </button>
  </form>
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-subscribe]",
  )) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const label = form.querySelector("[data-subscribe-label]");
      if (label) label.textContent = "Thanks for subscribing";
      form
        .querySelector<HTMLInputElement>("input[name='email']")
        ?.setAttribute("disabled", "true");
    });
  }
</script>
