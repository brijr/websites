---
import Icon from "~/components/Icon.astro";
import { WORK_WITH_ME_HREF } from "~/lib/constants";
---

<a
  class="fixed bottom-6 left-6 sm:left-1/2 sm:-translate-x-1/2 z-50 flex items-center gap-1.5 bg-primary text-primary-foreground px-4 min-h-11 rounded-full text-sm font-medium shadow-lg hover:bg-primary/90 transition-[background-color,scale] duration-200 ease-out active:scale-[0.97]"
  href={WORK_WITH_ME_HREF}
>
  Work with me
  <Icon name="arrow-up-right" size={16} />
</a>
