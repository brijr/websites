---
import { ROLES, SITE_NAME } from "~/lib/constants";

const initialRole = ROLES[0];
---

<section class="py-2 sm:py-4">
  <div class="max-w-2xl mx-auto p-4 sm:p-6 space-y-8">
    <div class="flex items-start justify-between gap-2">
      <div class="flex flex-col gap-2 flex-1 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <a class="text-muted-foreground" href="/">{SITE_NAME}</a>
          <h3 class="text-muted-foreground relative sm:hidden shrink-0">
            <span class="blur-entrance inline-block" data-role
              >{initialRole}</span
            >
          </h3>
        </div>
      </div>
      <h3 class="text-muted-foreground relative hidden sm:block shrink-0">
        <span class="blur-entrance inline-block" data-role>{initialRole}</span>
      </h3>
    </div>
  </div>
</section>

<script>
  import { ROLES } from "~/lib/constants";

  const spans = document.querySelectorAll<HTMLElement>("[data-role]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (spans.length && ROLES.length > 1 && !reduceMotion) {
    let index = 0;
    setInterval(() => {
      index = (index + 1) % ROLES.length;
      for (const span of spans) {
        span.textContent = ROLES[index];
        span.classList.remove("blur-entrance");
        // Force reflow so the animation restarts on each change.
        void span.offsetWidth;
        span.classList.add("blur-entrance");
      }
    }, 4000);
  }
</script>
