<footer
  class="hidden sm:block fixed bottom-6 left-6 text-muted-foreground text-sm"
>
  © <span class="tabular-nums" data-clock></span>
</footer>

<script>
  const nodes = document.querySelectorAll<HTMLElement>("[data-clock]");

  function tick() {
    const now = new Date();
    const mm = String(now.getMonth() + 1).padStart(2, "0");
    const dd = String(now.getDate()).padStart(2, "0");
    const yyyy = now.getFullYear();
    const hh = String(now.getHours()).padStart(2, "0");
    const min = String(now.getMinutes()).padStart(2, "0");
    const ss = String(now.getSeconds()).padStart(2, "0");
    const value = `${mm}/${dd}/${yyyy} ${hh}:${min}:${ss}`;
    for (const node of nodes) node.textContent = value;
  }

  if (nodes.length) {
    tick();
    setInterval(tick, 1000);
  }
</script>
