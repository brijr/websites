---
import Icon from "~/components/Icon.astro";

const buttonClass =
  "inline-flex items-center justify-center rounded-md text-sm font-medium transition-[background-color,color,border-color,scale] duration-200 ease-out active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10 fixed bottom-6 right-6 z-50 cursor-pointer";
---

<button
  type="button"
  data-mode-toggle
  aria-label="Switch to dark mode"
  class={buttonClass}
>
  <Icon
    name="sun"
    size={19}
    class="rotate-0 scale-100 transition-transform duration-200 ease-out dark:-rotate-90 dark:scale-0"
  />
  <Icon
    name="moon"
    size={19}
    class="absolute rotate-90 scale-0 transition-transform duration-200 ease-out dark:rotate-0 dark:scale-100"
  />
  <span class="sr-only">Toggle color mode</span>
</button>

<script>
  import { toggleTheme } from "~/lib/theme";

  for (const toggle of document.querySelectorAll("[data-mode-toggle]")) {
    toggle.addEventListener("click", () => toggleTheme());
  }
</script>
