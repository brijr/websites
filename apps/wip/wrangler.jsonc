{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wip",
  "main": "worker.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  // Canonical host is wipds.com. Other apex aliases stay attached so the
  // Worker can 301 them to SITE_URL. Deploying a custom_domain claims the
  // hostname — do that only at cutover.
  "routes": [
    { "pattern": "wipds.com", "custom_domain": true },
    { "pattern": "wip-design.com", "custom_domain": true },
    { "pattern": "wip.is", "custom_domain": true },
    { "pattern": "wipdes.com", "custom_domain": true },
    { "pattern": "wip0.com", "custom_domain": true },
    { "pattern": "wip.ad", "custom_domain": true },
  ],
}
