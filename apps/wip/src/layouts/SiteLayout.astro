---
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import BaseLayout from "@repo/ui/base-layout";
import "lenis/dist/lenis.css";

import ConsoleMessage from "~/components/ConsoleMessage.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import {
  BRAND_NAME,
  CONTACT_EMAIL,
  COPYRIGHT_NAME,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  SOCIAL_LINKS,
  THEME_COLOR,
  TWITTER_IMAGE_PATH,
  TWITTER_SITE,
} from "~/lib/constants";
import "~/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description = SITE_DESCRIPTION, robots } = Astro.props;
const documentTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageUrl = `${SITE_URL}${OG_IMAGE_PATH}`;
const imageAlt = "WIP — Design and Engineering Studio by Bridger Tower";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: BRAND_NAME,
      alternateName: "WIP",
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
    {
      "@type": "ProfessionalService",
      name: BRAND_NAME,
      alternateName: "WIP",
      url: SITE_URL,
      email: CONTACT_EMAIL,
      description: SITE_DESCRIPTION,
      image: ogImageUrl,
      founder: {
        "@type": "Person",
        name: COPYRIGHT_NAME,
        url: "https://bridger.to",
      },
      sameAs: [...SOCIAL_LINKS],
    },
  ],
};
---

<BaseLayout
  title={documentTitle}
  description={description}
  canonicalURL={canonicalURL}
  siteName={SITE_NAME}
  themeColor={THEME_COLOR}
  robots={robots}
  icon="/favicon.ico"
  image={{
    url: ogImageUrl,
    alt: imageAlt,
    width: OG_IMAGE_WIDTH,
    height: OG_IMAGE_HEIGHT,
  }}
  twitterCard="summary_large_image"
  twitterSite={TWITTER_SITE}
  twitterImage={`${SITE_URL}${TWITTER_IMAGE_PATH}`}
>
  <link
    slot="head-start"
    rel="preload"
    href={interLatin}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <script slot="head-start" is:inline>
    (() => {
      let stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {}
      const theme =
        stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      document.documentElement.classList.add(theme);
    })();
  </script>
  <meta slot="head" property="og:locale" content="en_US" />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <slot name="head" slot="head" />

  <div class="home-page bg-[--app-bg] min-h-screen text-[--app-fg]">
    <SiteHeader />
    <slot />
    <SiteFooter />
  </div>
  <ConsoleMessage />
</BaseLayout>

<script>
  import Lenis from "lenis";
  import { initTheme } from "~/lib/theme";

  initTheme();

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  new Lenis({
    autoRaf: true,
    duration: prefersReducedMotion ? 0 : 1.1,
    easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smoothWheel: !prefersReducedMotion,
    touchMultiplier: 1.5,
    syncTouch: false,
    anchors: true,
    infinite: false,
  });
</script>
