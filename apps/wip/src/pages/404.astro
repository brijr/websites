---
import SiteLayout from "~/layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" robots="noindex, follow">
  <main>
    <article class="relative z-40 p-6 pb-24">
      <div class="max-w-lg grid gap-3">
        <h1 class="font-light tracking-tight">Page not found</h1>
        <p class="text-[var(--app-fg-muted)]">
          The page you requested does not exist.
        </p>
      </div>
    </article>
  </main>
</SiteLayout>
