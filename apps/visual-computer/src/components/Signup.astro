---

<section class="signup" id="subscribe">
  <div class="row">
    <h2 class="section-statement">Stay in touch.</h2>
    <p class="signup-blurb">
      Notes on design, engineering, and AI. Sent occasionally.
    </p>
    <form class="signup-form" id="signup-form">
      <input
        type="email"
        name="email"
        placeholder="you@email.com"
        aria-label="Email address"
        required
      />
      <button type="submit">Subscribe</button>
    </form>
    <p class="signup-note">No spam. Unsubscribe anytime.</p>
    <p class="signup-success">Thanks. You'll hear from us soon.</p>
  </div>
</section>
