---
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import SiteLayout from "~/layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" robots="noindex, follow">
  <Header />
  <div
    class="fade-in text-center grid gap-6 text-lg max-w-xl m-auto my-24 md:my-32"
  >
    <h1 class="font-normal">Page not found.</h1>
    <p class="text-sm text-muted-foreground">
      The page you requested does not exist. <a
        class="underline underline-offset-2 hover:no-underline"
        href="/">Back home</a
      >.
    </p>
  </div>
  <Footer />
</SiteLayout>
