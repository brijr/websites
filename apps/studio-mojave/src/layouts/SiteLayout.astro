---
import BaseLayout from "@repo/ui/base-layout";
import "@fontsource-variable/dm-sans";

import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  THEME_COLOR,
} from "~/lib/constants";
import "~/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description = SITE_DESCRIPTION, robots } = Astro.props;
const documentTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
---

<BaseLayout
  title={documentTitle}
  description={description}
  canonicalURL={canonicalURL}
  siteName={SITE_NAME}
  themeColor={THEME_COLOR}
  robots={robots}
  icon="/favicon.ico"
>
  <slot name="head" slot="head" />

  <main>
    <section class="md:py-12 py-2">
      <div class="mx-auto max-w-5xl p-6 sm:p-8">
        <slot />
      </div>
    </section>
  </main>
</BaseLayout>
