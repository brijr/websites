---
import {
  COPYRIGHT_YEAR,
  DESIGNER_NAME,
  DESIGNER_URL,
  SITE_NAME,
  STUDIO_URL,
} from "~/lib/constants";
---

<div class="text-center text-sm max-w-xl m-auto mt-24 md:mt-32 not-prose">
  <p>
    © {COPYRIGHT_YEAR}
    <a class="underline underline-offset-2 hover:no-underline" href={STUDIO_URL}
      >{SITE_NAME}</a
    > by <a
      class="underline underline-offset-2 hover:no-underline"
      href={DESIGNER_URL}>{DESIGNER_NAME}</a
    > / Designed in the Desert 🏜️
  </p>
</div>
