---
import BaseLayout from "@repo/ui/base-layout";
import "@fontsource-variable/geist";
import "@fontsource/instrument-serif";

import {
  AUTHOR_NAME,
  KEYWORDS,
  OG_DESCRIPTION,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  THEME_COLOR,
} from "~/lib/constants";
import "~/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description = SITE_DESCRIPTION, robots } = Astro.props;
const documentTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageUrl = `${SITE_URL}${OG_IMAGE_PATH}`;
---

<BaseLayout
  title={documentTitle}
  description={description}
  canonicalURL={canonicalURL}
  siteName={SITE_NAME}
  themeColor={THEME_COLOR}
  robots={robots}
  icon="/favicon.ico"
  image={{
    url: ogImageUrl,
    alt: SITE_NAME,
    width: OG_IMAGE_WIDTH,
    height: OG_IMAGE_HEIGHT,
  }}
  twitterCard="summary_large_image"
  twitterImage={ogImageUrl}
>
  <script slot="head-start" is:inline>
    (() => {
      let stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {}
      const theme =
        stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      document.documentElement.classList.add(theme);
    })();
  </script>
  <meta slot="head" name="author" content={AUTHOR_NAME} />
  <meta slot="head" name="keywords" content={KEYWORDS} />
  <meta slot="head" property="og:locale" content="en_US" />
  <meta slot="head" property="og:description" content={OG_DESCRIPTION} />
  <slot name="head" slot="head" />

  <main class="min-h-screen divide-y">
    <slot />
  </main>
</BaseLayout>

<script>
  import { initTheme } from "~/lib/theme";

  initTheme();
</script>
