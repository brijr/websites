---
import ModeToggle from "~/components/ModeToggle.astro";
import { AUTHOR_NAME, AUTHOR_URL, SITE_NAME } from "~/lib/constants";

const year = new Date().getFullYear();
---

<section>
  <div class="max-w-2xl mx-auto p-4 sm:p-6 border-x bg-muted">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-muted-foreground">
        © {year}, {SITE_NAME} by <a
          href={AUTHOR_URL}
          target="_blank"
          rel="noopener">{AUTHOR_NAME}</a
        >.
      </p>
      <ModeToggle />
    </div>
  </div>
</section>
