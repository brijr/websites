---
import { CONTACT_HREF } from "~/lib/constants";
---

<section>
  <div class="max-w-2xl mx-auto p-4 sm:p-6 border-x !p-0">
    <div class="px-4 py-4 sm:px-6 sm:pt-6">
      <h3>How it works</h3>
      <h4 class="text-muted-foreground">
        This is a partnership, not a ticket queue.
      </h4>
    </div>
    <div class="grid sm:grid-cols-2 border-t border-border bg-border gap-px">
      <div class="bg-background p-4 sm:p-6">
        <p>
          We work together monthly — I become an extension of your team while
          you're building. Strategy, design, and code in one place.
        </p>
        <p class="text-muted-foreground mt-4">
          Best fit: founders building something new, or teams pushing what's
          live to the next level. You need a builder, not a roadmap.
        </p>
      </div>
      <div class="bg-background p-4 sm:p-6 flex flex-col justify-between gap-4">
        <div>
          <span class="text-muted-foreground text-sm">Starting at</span>
          <p class="text-2xl sm:text-3xl tracking-tight">$5k-$10k/month</p>
          <p class="text-muted-foreground mt-1">
            Async-first, focused hours, real output.
          </p>
        </div>
        <a href={CONTACT_HREF}>Start a conversation →</a>
      </div>
    </div>
  </div>
</section>
