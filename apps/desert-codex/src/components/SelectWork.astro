---
import { WORK_HREF } from "~/lib/constants";
import { WORK_LOGO_COUNT } from "~/lib/content";

const logos = Array.from({ length: WORK_LOGO_COUNT }, (_, index) => index + 1);
---

<section>
  <div class="max-w-2xl mx-auto p-4 sm:p-6 border-x !p-0 bg-muted">
    <h3 class="px-4 py-4 sm:px-6 sm:pt-6">Select work</h3>
    <div
      class="grid grid-cols-2 sm:grid-cols-3 border-t border-border bg-border gap-px"
    >
      {
        logos.map((n) => (
          <a
            href={WORK_HREF}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center p-8 bg-background grayscale hover:brightness-110 transition-colors"
          >
            <img
              src="/logo.svg"
              alt={`Logo${n}`}
              width="239"
              height="40"
              loading="lazy"
              decoding="async"
              class="h-6 brightness-0 dark:brightness-100 dark:invert"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
