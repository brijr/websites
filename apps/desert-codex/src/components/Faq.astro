---
import { FAQS } from "~/lib/content";
---

<section>
  <div class="max-w-2xl mx-auto p-4 sm:p-6 border-x !p-0">
    <h3 class="px-4 py-4 sm:px-6 sm:pt-6">FAQ</h3>
    <div class="grid sm:grid-cols-2 border-t border-border bg-border gap-px">
      {
        FAQS.map((faq) => (
          <div class="bg-background p-4 sm:p-6">
            <h4>{faq.question}</h4>
            <p class="text-muted-foreground mt-2">{faq.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
