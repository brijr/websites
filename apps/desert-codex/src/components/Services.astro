---
import { SERVICES } from "~/lib/content";
---

<section>
  <div class="max-w-2xl mx-auto p-4 sm:p-6 border-x !p-0 bg-muted">
    <div class="px-4 py-4 sm:px-6 sm:pt-6">
      <h2>What I do</h2>
      <h3 class="text-muted-foreground">
        From concept to traction. New products and critical iterations.
      </h3>
    </div>
    <div class="grid sm:grid-cols-2 border-t border-border bg-border gap-px">
      {
        SERVICES.map((service) => (
          <div class="bg-background p-4 sm:p-6">
            <span class="text-muted-foreground tabular-nums">
              {service.number}
            </span>
            <h4 class="mt-2">{service.title}</h4>
            <p class="text-muted-foreground mt-2">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
